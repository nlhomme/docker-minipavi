# Valeurs lues par docker-compose.yml. Copier ce fichier en ".env", puis l'adapter.
# Le fichier .env contient des mots de passe : il n'est pas enregistré dans git.
# Une ligne commentée ou vide laisse la valeur par défaut. Chaque variable est décrite dans documentation/.
# Une valeur qui contient un $ s'écrit entre apostrophes : MOT_DE_PASSE='pa$se'

# --- Obligatoire ---------------------------------------------------------------------------

# Mot de passe de VisuWeb, l'interface web de la passerelle
MINIPAVI_HTTP_PASSWORD=

# --- Version de MiniPavi (documentation/01-version-minipavi.md) ------------------------------------

# "latest" = dernière release ; sinon un numéro de release, ex. 1.6.1
MINIPAVI_VERSION=latest

# --- Adresses publiques (documentation/02-liaisons.md) ----------------------------------------------
# Les valeurs par défaut conviennent pour un essai sur sa propre machine.

#GATEWAY_URL=wss://passerelle.exemple.org:443/
#MINIPAVI_VIEWER_URL=https://minitel.exemple.org:443/
#WEBMEDIA_URL=https://visuweb.exemple.org?action=webmedia

# --- Passerelle (documentation/10-passerelle.md) ----------------------------------------------------

#MINIPAVI_HTTP_USER=minipavi
#MINIPAVI_VERBOSE=0
#MINIPAVI_WS_PORT=8181
#MINIPAVI_HOST=127.0.0.1
#MINIPAVI_CONNECT_KEY=Key1234
#MINIPAVI_VISU_KEY=123abc

# --- Profil accueil-extcall (documentation/13-accueil-extcall.md) -----------------------------------
# À décommenter pour que la passerelle utilise les services de ce profil.

#MINIPAVI_DEFAULT_URL=http://accueil-extcall:8080/MiniPaviAcc/
#MINIPAVI_EXTCALL_URL=http://accueil-extcall:8080/EXTcall/

# --- Profil asterisk (documentation/14-asterisk.md) -------------------------------------------------

#SIP_SERVER=sip.exemple.org
#SIP_USERNAME=0033123456789
#SIP_PASSWORD=
#ASTERISK_EXTERNAL_ADDRESS=203.0.113.10

# Appels entrants : port de la passerelle pour Asterisk
#MINIPAVI_AST_PORT=8183

# Mot de passe de l'AMI, commun à la passerelle et à Asterisk
#MINIPAVI_AMI_PASSWORD=

# Appels sortants : à renseigner en plus du mot de passe de l'AMI
#MINIPAVI_AMI_HOST=asterisk
#MINIPAVI_SIP_CHANNEL=PJSIP/trunk/sip:%NUM%@sip.exemple.org

#MINIPAVI_AMI_USER=minipavi
#MINIPAVI_AMI_PORT=5038
#ASTERISK_VERSION=22
#ASTERISK_LOCAL_NET=172.16.0.0/12
#AMI_PERMIT=172.16.0.0/255.240.0.0
#RTP_START=10000
#RTP_END=10100
