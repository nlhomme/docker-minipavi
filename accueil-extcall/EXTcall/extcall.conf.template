<?xml version="1.0" encoding="utf-8"?>
<!--
Serveurs externes joignables par le service EXTcall.
La clé est celle de la passerelle (même variable MINIPAVI_CONNECT_KEY). Voir documentation/13-accueil-extcall.md
La liste ci-dessous est l'exemple fourni avec MiniPavi : à adapter.
Les serveurs de type "tel" (appel téléphonique) demandent un serveur Asterisk.
-->
<config>
	<extcall key="${MINIPAVI_CONNECT_KEY:-Key1234}">
		<serveur id="iut" type="tel">
			<nom>IUT Auxerre</nom>
			<numero>0358435150</numero>
			<rx>-35</rx>
			<tx>-28</tx>
		</serveur>
		<serveur id="retrocampus" type="int">
			<nom>RETROCAMPUS</nom>
			<host>bbs.retrocampus.com:1651</host>
			<echo>off</echo>
			<case>lower</case>
		</serveur>
		<serveur id="hacker" type="ws">
			<nom>HACKER</nom>
			<host>mntl.joher.com:2018</host>
			<path>/</path>
			<echo>on</echo>
			<case>upper</case>
		</serveur>
		<serveur id="sm" type="ws">
			<nom>SM - Serveur médical</nom>
			<host>ssl://wss.3615.live:9991</host>
			<path>/?echo</path>
		</serveur>
		<serveur id="teaser" type="ws">
			<nom>TEASER</nom>
			<host>minitel.3614teaser.fr:3614</host>
			<path>/ws</path>
			<proto>tty</proto>
		</serveur>
	</extcall>
</config>