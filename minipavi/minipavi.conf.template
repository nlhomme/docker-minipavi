<?xml version="1.0" encoding="utf-8"?>
<!-- Modèle de configuration de la passerelle : les variables d'environnement sont expliquées dans documentation/10-passerelle.md -->
<config>
	<general>
		<host>${MINIPAVI_HOST:-127.0.0.1}</host>			<!-- Adresse de connexion au serveur, sans le port (si locale, certains services de visuweb ne fonctionneront qu'en local) -->
		<verbose>${MINIPAVI_VERBOSE:-0}</verbose>				<!-- 1 si logs PHP verbose -->
		<durl>${MINIPAVI_DEFAULT_URL:-http://www.minipavi.fr/minipavitest/}</durl>	<!-- Url du service par défaut lors d'une connexion -->
		<maxc>20</maxc>						<!-- Nombre de connectés simultanés maximum -->
		<timeout>600</timeout>				<!-- Période maximum d'inactivité avant deconnexion (secondes) -->
		<maxhisto>40</maxhisto>				<!-- Max historique clients -->
		<wsport>${MINIPAVI_WS_PORT:-8181}</wsport>				<!-- Port pour connexion websocket non sécurisée -->
		<astport>${MINIPAVI_AST_PORT:-0}</astport>				<!-- Port pour les connexions venant du serveur Asterisk (0 = désactivé) -->
		<httpport>8080</httpport>			<!-- Port pour accès à VisuWeb (interface web) -->
		<httpuser>${MINIPAVI_HTTP_USER:-minipavi}</httpuser>		<!-- Nom utilisateur pour l'accès à VisuWeb -->
		<httppwd>${MINIPAVI_HTTP_PASSWORD}</httppwd>				<!-- Mot de passe pour l'accès à VisuWeb -->
		<lpath>./logs</lpath>				<!-- Emplacement des logs MiniPavi -->
		<spath>./stats</spath>				<!-- Emplacement des fichiers stats -->
		<viewer>${MINIPAVI_VIEWER_URL}</viewer>		<!-- Url d'une page ou est installé un émulateur Minitel pour la visualisation des sessions en direct et enregistrées. Doit pouvoir accepter un paramètre "gw" indiquant l'adresse WEBSOCKET du serveur auquel se connecter et/ou un paramètre "url" indiquant l'adresse HTTP du service à afficher -->
		<visuweb>							<!-- Les ip indiquées n'auront pas besoin de login/password pour accèder à l'interface web -->
			<allowip></allowip>
		</visuweb>
	</general>
	<connecttocmd>
		<key>${MINIPAVI_CONNECT_KEY:-Key1234}</key>	<!-- Clé d'autorisation pour les commandes de connexion vers l'exterieur (VoIP, Telnet, Websocket, visualisation...) -->
		<!-- SI MINIPAVI_AMI_PASSWORD -->
		<asterisk>							<!-- Appels sortants par le serveur Asterisk : section présente seulement si MINIPAVI_AMI_PASSWORD est renseignée -->
			<sipchannel>${MINIPAVI_SIP_CHANNEL}</sipchannel>	<!-- SIP channel serveur Asterisk, ex. PJSIP/trunk/sip:%NUM%@sip.exemple.org -->
			<ip>${MINIPAVI_AMI_HOST}</ip>				<!-- Adresse du serveur Asterisk -->
			<port>${MINIPAVI_AMI_PORT:-5038}</port>				<!-- Port AMI -->
			<user>${MINIPAVI_AMI_USER:-minipavi}</user>			<!-- Défini dans manager.conf (Asterisk) -->
			<pwd>${MINIPAVI_AMI_PASSWORD}</pwd>			<!-- Défini dans manager.conf (Asterisk) -->
			<context>extcall</context>		<!-- Défini dans extensions.conf (Asterisk) -->
			<ext>999</ext>					<!-- Défini dans extensions.conf (Asterisk) -->
			<maxtime>600</maxtime>			<!-- Durée maximum d'une connexion -->
			<calltimeout>7000</calltimeout>	<!-- Timout attente décrochage (en ms) -->
		</asterisk>
		<!-- FIN SI -->
		<extcallurl>${MINIPAVI_EXTCALL_URL:-http://www.minipavi.fr/EXTcall/}</extcallurl>	<!-- Url du service EXTcall (pour activer la visualisation des utilisateurs connectés) -->
		<visukey>${MINIPAVI_VISU_KEY:-123abc}</visukey>		<!-- Clé pour la visualisation des utilisateurs -->
	</connecttocmd>
	<recordings>
		<rpath>./recordings</rpath>			<!-- Emplacement des enregistrements de sessions des utilisateurs -->
	</recordings>
</config>
