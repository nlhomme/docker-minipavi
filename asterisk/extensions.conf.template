; extensions.conf - the Asterisk dial plan
;
; Modèle : seules ${MINIPAVI_HOST} et ${MINIPAVI_AST_PORT} sont remplacées au démarrage du conteneur
; (voir documentation/14-asterisk.md). Les autres ${...} sont des variables d'Asterisk et restent telles quelles.
; Repris de l'exemple fourni avec MiniPavi.

[general]
static=yes
writeprotect=yes
clearglobalvars=no

; ************************************
; ***                              ***
; ***        MINIPAVI              ***
; ***                              ***
; ************************************


[minipavi]
; Prise en charge d'un appel entrant suite à l'appel d'un utilisateur
exten => s,1,Verbose(Appel ${PJSIP_HEADER(read,To)} de ${CDR(src)})
exten => s,n,Verbose(Appel recu)
exten => s,n,Set(VOLUME(TX)=2)
exten => s,n,Set(VOLUME(RX)=3)
exten => s,n,Answer()
exten => s,n,Wait(1)
; Le "1" active la PCE (correction d'erreurs) pour les appels entrants ; "0" pour la désactiver
exten => s,n,SoftmodemMinipavi("${MINIPAVI_HOST}", ${MINIPAVI_AST_PORT},"${CDR(src)}","",1,r(-38)t(-28))
exten => s,n,Hangup()

[extcall]
; Prise en charge d'un appels sortant suite à l'appel effectué par MiniPavi
exten => 999,1,Verbose(APPEL ${CALLED} DEPUIS MINIPAVI RX=${RX} TX=${TX})
same => n,Set(VOLUME(TX)=2)
same => n,Set(VOLUME(RX)=7)
same => n,Answer()
same => n,Set(MASTER_CHANNEL(PJSIP_MEDIA_OFFER(audio))=!all,alaw)
same => n,Set(MASTER_CHANNEL(PJSIP_SEND_SESSION_REFRESH())=invite)
same => n,Verbose(Attente)
same => n,Wait(10)
same => n,Verbose(Connexion softmodem)
same => n,SoftmodemMinipavi("${MINIPAVI_HOST}", ${MINIPAVI_AST_PORT}, "TO ${CALLED}","${PID}",0,ft(${TX})r(${RX}))
same => n,Hangup()

[public]
include => minipavi
